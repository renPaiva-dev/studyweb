# Copie para .env (gitignored) e preencha antes de rodar `docker compose up`.
# Nenhuma dessas variaveis tem valor real aqui — nunca commite um .env de
# verdade (ver .gitignore).

# --- Backend ---
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Gere um valor aleatorio de pelo menos 32 caracteres (ex.: openssl rand -base64 32).
# Sem isso definido, a aplicacao sobe com um valor de fallback fraco e avisa no log.
JWT_SECRET=

# Chave da API do Gemini (https://aistudio.google.com/apikey). Sem isso, a
# geracao de flashcards/provas via IA nao funciona.
GEMINI_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# URL publica do frontend - usada para montar os links clicaveis nos e-mails
# de verificacao de cadastro e redefinicao de senha.
FRONTEND_URL=http://localhost:5173

# SMTP para envio real de e-mail (verificacao de cadastro, redefinicao de
# senha). Sem isso definido, o backend so loga o conteudo (nao envia de
# verdade) - ver EmailService. Exemplo com Gmail: MAIL_HOST=smtp.gmail.com,
# MAIL_USERNAME=seu-email@gmail.com, MAIL_PASSWORD=senha de app (nao a senha
# normal da conta - gere em myaccount.google.com/apppasswords, exige
# verificacao em duas etapas ativada).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Frontend (build-time — ver frontend/.env.example) ---
VITE_API_URL=http://localhost:8080
