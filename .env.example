# Copie para .env (gitignored) e preencha antes de rodar `docker compose up`.
# Nenhuma dessas variaveis tem valor real aqui — nunca commite um .env de
# verdade (ver .gitignore).

# --- Backend ---
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Gere um valor aleatorio de pelo menos 32 caracteres (ex.: openssl rand -base64 32).
# Sem isso definido, a aplicacao sobe com um valor de fallback fraco e avisa no log.
JWT_SECRET=

# Chave da API do Gemini (https://aistudio.google.com/apikey). Sem isso, a
# geracao de flashcards/provas via IA nao funciona.
GEMINI_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (build-time — ver frontend/.env.example) ---
VITE_API_URL=http://localhost:8080
